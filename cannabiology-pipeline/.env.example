# Copy to .env (gitignored) or export in your shell. Never commit a real key.

# Absolute path OUTSIDE this repository. Required - the pipeline fails closed
# without it, so client-derived material cannot land in a public repo.
CANNABIOLOGY_WORKSPACE=/absolute/private/path/cannabiology-workspace

# Required only to leave dry-run. Read from the environment, never stored.
OPENAI_API_KEY=

# Optional model overrides (defaults live in config/pipeline.yaml)
# CANNABIOLOGY_IMAGE_MODEL=gpt-image-2
# CANNABIOLOGY_OA_ROUTINE_MODEL=gpt-5.6-terra
# CANNABIOLOGY_OA_FINAL_MODEL=gpt-5.6-sol
# CANNABIOLOGY_MAX_CONCURRENT=2
