{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cannabiology OA review result",
  "type": "object",
  "required": ["figure_id", "candidate_id", "issues", "preserve", "confidence"],
  "properties": {
    "figure_id": {"type": "string", "pattern": "^CH[0-9]{2}-IMG-[0-9]{2}[A-Z]?$"},
    "candidate_id": {"type": "string"},
    "review_round": {"type": "integer", "minimum": 1},
    "visual_pass": {"type": "boolean"},
    "scientific_pass": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "severity", "description", "repair_type"],
        "properties": {
          "category": {"type": "string", "enum": [
            "ANATOMY", "BOTANY", "CHEMISTRY", "GENETICS", "EMPIRICAL_DATA",
            "GENERATED_TEXT", "IMPLIED_PRECISION", "COMPOSITION", "CLUTTER",
            "HIERARCHY", "CROPPING", "LABEL_READINESS", "STYLE", "PURPOSE_FIDELITY",
            "REGRESSION", "PRESERVE_DAMAGE"]},
          "severity": {"type": "string", "enum": ["BLOCKER", "MAJOR", "MINOR"]},
          "description": {"type": "string"},
          "evidence": {"type": "string"},
          "repair_type": {"type": "string", "enum": [
            "VECTOR_EDIT", "IMAGE_EDIT", "REGENERATE", "HUMAN_CONFIRMATION", "NONE"]}
        }
      }
    },
    "preserve": {"type": "array", "items": {"type": "string"}},
    "manual_overlay_required": {"type": "array", "items": {"type": "string"}},
    "human_confirmation_required": {"type": "boolean"},
    "recommended_action": {"type": "string", "enum": [
      "NONE", "VECTOR_EDIT", "IMAGE_EDIT", "REGENERATE", "HUMAN_CONFIRMATION"]},
    "repair_instructions": {"type": "string"},
    "summary": {"type": "string"}
  }
}
