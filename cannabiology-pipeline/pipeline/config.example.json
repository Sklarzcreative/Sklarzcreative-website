{
  "_comment": "Copy to config.json (gitignored) and fill in. No key is stored in this repo.",
  "image_generation": {
    "provider": "dry-run",
    "_providers": ["dry-run", "openai", "gemini", "manual"],
    "openai": {
      "model": "gpt-image-1",
      "api_key_env": "OPENAI_API_KEY",
      "size": "1536x1024",
      "quality": "high",
      "endpoint": "https://api.openai.com/v1/images/generations"
    },
    "gemini": {
      "model": "gemini-3-pro-image-preview",
      "api_key_env": "GEMINI_API_KEY",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta/models"
    }
  },
  "oa_review": {
    "provider": "manual",
    "_providers": ["manual", "anthropic", "openai"],
    "_manual_note": "manual = emit a review brief for a human or an in-session Claude Code vision review. Works today with zero API keys.",
    "anthropic": {
      "model": "claude-opus-4-5",
      "api_key_env": "ANTHROPIC_API_KEY",
      "endpoint": "https://api.anthropic.com/v1/messages"
    }
  },
  "paths": {
    "client_data": "../client-data"
  }
}
