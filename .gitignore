# This repository is public. Nothing that could carry a credential belongs in
# it — the lead-capture endpoint is a public write-only URL, and any real key
# lives in the external service's own settings, never here. These patterns are
# so an accidental `git add .` cannot publish one.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*

# A downloaded Google service-account key is named like
# sklarz-creative-1a2b3c4d5e6f.json, which matches none of the patterns above.
# No JSON file is tracked under the publisher, so ignore the lot.
automation/social-publisher/*.json

# Python local environment
.venv/
venv/
__pycache__/
*.pyc

# Node local environment. The site is plain static files with no build step, so
# an installed tree here is always local tooling - a headless browser used to
# check layout, say - and never something the site is served from.
node_modules/
npm-debug.log*
yarn-error.log*

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
